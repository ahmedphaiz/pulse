<?xml version="1.0" encoding="utf-8"?>
<!-- Live heart-rate card shown in the notification shade and on the lock screen during a workout -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:background="@drawable/notif_bg"
    android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="12dp" android:paddingBottom="12dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="PULSE" android:textColor="#CCFFFFFF" android:textSize="13sp" android:letterSpacing="0.12" android:singleLine="true" />
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical"
            android:background="@drawable/chip_bg" android:paddingStart="8dp" android:paddingEnd="10dp" android:paddingTop="3dp" android:paddingBottom="3dp">
            <ImageView android:layout_width="15dp" android:layout_height="15dp" android:src="@drawable/ic_timer" />
            <Chronometer android:id="@+id/timer" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="5dp"
                android:textColor="#FFFFFFFF" android:textSize="15sp" android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="6dp">
        <ImageView android:id="@+id/heart" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_heart" />
        <TextView android:id="@+id/bpm" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp"
            android:text="--" android:textColor="#FFFFFFFF" android:textSize="36sp" android:textStyle="bold" android:includeFontPadding="false" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:layout_marginTop="10dp"
            android:text="bpm" android:textColor="#B3FFFFFF" android:textSize="14sp" />
        <TextView android:id="@+id/zone" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="end"
            android:text="" android:textColor="#FFC5F25A" android:textSize="14sp" android:textStyle="bold" android:singleLine="true" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="10dp">
        <TextView android:id="@+id/s1" android:layout_width="0dp" android:layout_height="5dp" android:layout_weight="1" android:layout_marginEnd="3dp" android:background="#33FFFFFF" />
        <TextView android:id="@+id/s2" android:layout_width="0dp" android:layout_height="5dp" android:layout_weight="1" android:layout_marginEnd="3dp" android:background="#33FFFFFF" />
        <TextView android:id="@+id/s3" android:layout_width="0dp" android:layout_height="5dp" android:layout_weight="1" android:layout_marginEnd="3dp" android:background="#33FFFFFF" />
        <TextView android:id="@+id/s4" android:layout_width="0dp" android:layout_height="5dp" android:layout_weight="1" android:layout_marginEnd="3dp" android:background="#33FFFFFF" />
        <TextView android:id="@+id/s5" android:layout_width="0dp" android:layout_height="5dp" android:layout_weight="1" android:layout_marginEnd="0dp" android:background="#33FFFFFF" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="6dp">
        <TextView android:id="@+id/z1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="ZONE 1" android:textColor="#80FFFFFF" android:textSize="10sp" android:textStyle="bold" android:letterSpacing="0.04" />
        <TextView android:id="@+id/z2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="ZONE 2" android:textColor="#80FFFFFF" android:textSize="10sp" android:textStyle="bold" android:letterSpacing="0.04" />
        <TextView android:id="@+id/z3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="ZONE 3" android:textColor="#80FFFFFF" android:textSize="10sp" android:textStyle="bold" android:letterSpacing="0.04" />
        <TextView android:id="@+id/z4" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="ZONE 4" android:textColor="#80FFFFFF" android:textSize="10sp" android:textStyle="bold" android:letterSpacing="0.04" />
        <TextView android:id="@+id/z5" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="ZONE 5" android:textColor="#80FFFFFF" android:textSize="10sp" android:textStyle="bold" android:letterSpacing="0.04" />
    </LinearLayout>
    <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp"
        android:textColor="#99FFFFFF" android:textSize="12sp" android:singleLine="true" />
</LinearLayout>
